# Required for the server-side HttpOnly dashboard session.
PPGSCOPE_AUTH_PASSWORD=replace-with-a-long-random-password
PPGSCOPE_AUTH_SECRET=replace-with-at-least-32-random-characters

# Optional server-side integrations. Never prefix these with NEXT_PUBLIC_.
PPGSCOPE_GEMINI_API_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
